# syntax=docker/dockerfile:1.6
# GPU Docker image for `silicon_sampling` on a single NVIDIA GeForce RTX 4090.
#
# Same inference stack as social_deduction_llm/container/message_annotation_glm52.def
# (vLLM 0.23.0 + Transformers 5.12.1), but the CUDA 12.9 image instead of the
# default CUDA 13 `vllm/vllm-openai:v0.23.0` used on H200/B200.
#
# Official image facts (v0.23.0-cu129):
#   CUDA 12.9.1, Python 3.12, FlashInfer 0.6.12
#   torch_cuda_arch_list includes 8.9 (Ada / RTX 4090)
#   opencv-python-headless 4.13+ requires numpy>=2 on Python >=3.9
#
# Host NVIDIA driver must be >= 575.51 (CUDA 12.9). GeForce cannot use CUDA
# forward-compat. Stock vLLM GLM-5.2 DSA kernels remain Hopper/Blackwell-only;
# this stack serves other new models that fit in 24 GB.

FROM vllm/vllm-openai:v0.23.0-cu129

USER root

ARG DEBIAN_FRONTEND=noninteractive
ENV PIP_NO_CACHE_DIR=1 \
    PIP_DEFAULT_TIMEOUT=600 \
    UV_NO_CACHE=1 \
    UV_LINK_MODE=copy \
    UV_HTTP_TIMEOUT=900 \
    LC_ALL=C.UTF-8 \
    LANG=C.UTF-8 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    TORCH_CUDA_ARCH_LIST=8.9

# Official image ENTRYPOINT is `vllm serve`; this is a workstation image.
ENTRYPOINT []

# -------- system packages / Claude helper CLIs -----------------------------
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl git gnupg openssh-client \
        build-essential pkg-config ninja-build \
        libopenblas-dev libgl1 libglib2.0-0 libsm6 libxext6 libxrender1 \
        libnuma-dev libaio-dev \
        locales \
        jq ripgrep fd-find \
        tree file xxd \
        unzip zip xz-utils \
        procps lsof \
        sqlite3 \
    && ln -sf /usr/bin/fdfind /usr/local/bin/fd \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3 1 \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# -------- Node.js 22 + Claude Code CLI -------------------------------------
ARG CLAUDE_CODE_CACHEBUST=1
RUN echo "claude-code cachebust=${CLAUDE_CODE_CACHEBUST}" \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g @anthropic-ai/claude-code@latest \
    && claude --version \
    && rm -rf /var/lib/apt/lists/* /root/.npm

# -------- Transformers 5.12.1 (same overlay as message_annotation_glm52.def)
RUN uv pip install --system --index-strategy unsafe-best-match \
        "transformers==5.12.1" \
        "huggingface-hub>=1.5,<2"

# -------- extra workstation packages ---------------------------------------
COPY container/requirements.filtered.txt /opt/requirements.filtered.txt
# `--no-deps` so leftover pins cannot downgrade the official vLLM stack.
# Inference-stack names are stripped even if they reappear in the extras file.
RUN set -e; \
    grep -vE '^(#|$)' /opt/requirements.filtered.txt \
      | grep -vE '^(vllm|torch|torchvision|torchaudio|triton|transformers|huggingface[_-]hub|tokenizers|numpy|opencv-python-headless|flashinfer-cubin|flashinfer-python|xformers|compressed-tensors|outlines_core|xgrammar|lm-format-enforcer|llguidance|apache-tvm-ffi|depyf|openai-harmony|gguf|mistral_common|numba|llvmlite|protobuf|nvidia-.+|cuda-bindings|cuda-pathfinder|cuda-python|cupy-cuda12x|tilelang|fastsafetensors|quack-kernels|tokenspeed-mla|humming-kernels|flash_attn|flash-attn|bitsandbytes)(==|$|\[)' \
      > /opt/requirements.gpu.txt; \
    echo "--- extras after stripping inference stack ---"; \
    wc -l /opt/requirements.gpu.txt; \
    uv pip install --system --no-deps --index-strategy unsafe-best-match \
        -r /opt/requirements.gpu.txt

RUN uv pip install --system --no-deps "ykutil" \
    && uv pip install --system black flake8

# -------- bson / pymongo collision fix -------------------------------------
RUN python3 -m pip uninstall -y bson || true \
    && python3 -m pip install --no-deps --force-reinstall --no-cache-dir pymongo==4.16.0

# -------- first-party source -----------------------------------------------
COPY pyproject.toml                      /opt/silicon_sampling/pyproject.toml
COPY README.md                           /opt/silicon_sampling/README.md
COPY silicon_sampling                       /opt/silicon_sampling/silicon_sampling

RUN uv pip install --system --no-deps -e /opt/silicon_sampling

# -------- import sanity check (torch/vLLM already consistent in the base image)
RUN python3 - <<'PY'
import importlib
import importlib.metadata as metadata

mods = (
    "torch", "torchvision", "torchaudio",
    "transformers", "datasets", "accelerate", "peft",
    "flashinfer", "silicon_sampling", "ykutil",
)
for m in mods:
    importlib.import_module(m)
    print(f"[ok] import {m}")

import torch
print(f"torch {torch.__version__}  cuda_build={torch.version.cuda}  is_available={torch.cuda.is_available()}")
print(
    f"vllm {metadata.version('vllm')}  "
    f"transformers {metadata.version('transformers')}  "
    f"huggingface-hub {metadata.version('huggingface-hub')}  "
    f"numpy {metadata.version('numpy')}"
)

from bson import SON  # noqa: F401
import pymongo
print(f"pymongo {pymongo.__version__} OK; SON from {SON.__module__}")
PY

RUN apt-get clean \
    && rm -rf /var/lib/apt/lists/* /root/.cache /root/.cargo /root/.rustup \
    && find /usr -name '__pycache__' -type d -prune -exec rm -rf {} + 2>/dev/null || true

ENV HF_HOME=/tmp/hf_home \
    TRITON_CACHE_DIR=/tmp/triton_cache \
    TORCH_EXTENSIONS_DIR=/tmp/torch_extensions

ARG USER_ID=1000
ARG GROUP_ID=1000

RUN set -eux; \
    if ! getent group "${GROUP_ID}" >/dev/null; then \
        groupadd -g "${GROUP_ID}" claude; \
    fi; \
    if ! getent passwd "${USER_ID}" >/dev/null; then \
        useradd -m -u "${USER_ID}" -g "${GROUP_ID}" -s /bin/bash claude; \
    else \
        existing_user="$(getent passwd "${USER_ID}" | cut -d: -f1)"; \
        usermod -d /home/claude -m "${existing_user}" || true; \
        usermod -l claude "${existing_user}" || true; \
    fi; \
    mkdir -p /home/claude /home/claude/.cache /workspace /opt/silicon_sampling; \
    chown -R "${USER_ID}:${GROUP_ID}" /home/claude /workspace; \
    chown -R "${USER_ID}:${GROUP_ID}" /opt/silicon_sampling

ENV HOME=/home/claude

USER ${USER_ID}:${GROUP_ID}

COPY container/.gitconfig /home/claude/.gitconfig

WORKDIR /opt/silicon_sampling

LABEL org.opencontainers.image.title="silicon_sampling-gpu-rtx4090" \
      org.opencontainers.image.description="GPU Docker image for silicon_sampling on RTX 4090 (vllm/vllm-openai:v0.23.0-cu129 + Transformers 5.12.1)" \
      org.opencontainers.image.authors="Yannik Keller <ykeller@mpib-berlin.mpg.de>" \
      org.opencontainers.image.version="0.2.0"

CMD ["python3"]
